# Copy this file to `.env` for local development.
# Do not put real production secrets in this example file.

POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=your_database_name

# Docker Compose backend -> database URL.
# Keep host as `db` when running the backend inside Docker Compose.
DATABASE_URL=postgresql+asyncpg://your_postgres_user:your_postgres_password@db:5432/your_database_name

# Replace with a long random value in your real `.env`.
# In production (ENV=production) the app refuses to start if this is a
# placeholder or shorter than 32 chars. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret

# Deployment environment: "development" (default) or "production".
# In production, security headers are emitted and the SECRET_KEY/ALLOWED_ORIGINS
# strength checks are enforced.
ENV=development

# Comma-separated CORS origins allowed to call the API with credentials.
# Never use "*" here in production.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Host-local LM Studio server used by the optional MVP extraction pipeline.
# Inside Docker, docker-compose overrides this with host.docker.internal.
LLM_BASE_URL=http://localhost:1234/v1
LLM_TIMEOUT_S=30
# Usually leave blank so the backend reads the loaded model id from /v1/models.
LLM_MODEL=

# Razorpay billing (Phase 3). Leave blank to disable payments in dev/tests —
# order creation is refused and the webhook rejects everything until these are
# set. Never commit real keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Frontend -> backend API URL.
VITE_API_URL=http://localhost:8000

# Internal-only frontend tools. Keep false for the normal product UI.
VITE_SHOW_DEV_TOOLS=false
